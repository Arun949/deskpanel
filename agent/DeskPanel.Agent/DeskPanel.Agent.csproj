<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>DeskPanelAgent</AssemblyName>
    <RootNamespace>DeskPanel.Agent</RootNamespace>
    <Description>DeskPanel desktop agent: serves the phone panel over an authenticated local API.</Description>
    <!-- needed by the LibraryImport source generator (Mach / sysctl calls); no hand-written unsafe code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- On Windows the agent targets the Windows 10 (2004+) API surface for the system media session (WinRT); the SDK then
       defines the WINDOWS symbol. Everything else is plain .NET guarded by OperatingSystem checks. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Admin/wwwroot/*.*" LogicalName="admin/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Layout/widgets.json" LogicalName="widgets.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskPanel.Agent.Tests" />
  </ItemGroup>

</Project>
